# Local telemetry keys for Playa (gitignored when copied to `.env.local`).
# Never commit real DSNs/tokens. Blank values keep Sentry/PostHog inert.
#
# Wire into flutter via:
#   scripts/run_with_telemetry.ps1 -Mode release -Device <id>
# or manually:
#   flutter run --dart-define-from-file=.env.local
#
# SDKs only initialize when:
#   1) a key below is non-empty
#   2) the user opted in (onboarding Privacy page or Settings → Privacy)
#   3) release build, OR PLAYA_TELEMETRY_DEBUG=true

PLAYA_SENTRY_DSN=
PLAYA_POSTHOG_KEY=
PLAYA_POSTHOG_HOST=https://us.i.posthog.com
PLAYA_TELEMETRY_DEBUG=
